# News APIs are optional. Without them the app uses RSS feeds.
GNEWS_API_KEY=
NEWSAPI_KEY=
WORLDNEWS_API_KEY=

# Translation is optional. Google Translate is used as a fallback.
DEEPL_API_KEY=

# Required only when running the Telegram bot.
TELEGRAM_BOT_TOKEN=
WEBAPP_URL=http://localhost:8000/app/

# Local API server.
HOST=127.0.0.1
PORT=8000
DEBUG=false
