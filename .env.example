# Random World News Environment Variables
# Copy this file to .env and fill in your API keys

# News APIs (get free keys at these sites)
GNEWS_API_KEY=your_gnews_api_key_here           # https://gnews.io - 100 req/day free
WORLDNEWS_API_KEY=your_worldnews_api_key_here   # https://worldnewsapi.com - 100 req/day free

# Translation API (optional - uses googletrans as fallback)
DEEPL_API_KEY=your_deepl_api_key_here           # https://www.deepl.com/pro-api - 500K chars/month free

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here # From @BotFather

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
